# Copy to .env for local development (or let `task setup` create it):
#   cp .env.example .env
# Every variable is optional; the comments show the defaults.

# Server
PORT=8080
APP_ENV=local
APP_URL=http://localhost:8080
APP_SOURCE_URL=https://github.com/sudo-adduser-jordan/eveindustry

# Embedded SQLite file (created on open; `task migrate -- up` makes the schema).
DB_PATH=storage/eveindustry.sqlite

# Sessions: stateless HMAC cookies. Leave both empty for local dev (an
# ephemeral key is generated and logins die on restart); set one in
# production. APP_KEY also decrypts ESI tokens stored encrypted-at-rest.
SESSION_KEY=
APP_KEY=
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

# EVE SSO (login + ESI data). Empty = SSO disabled; the demo still works.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
ESI_USER_AGENT=EveIndustrialist/1.0
ESI_COMPATIBILITY_DATE=

# Demo account ("Try the demo" on the login page; data resets daily 03:30 UTC).
DEMO_ENABLED=true
DEMO_RESET_TIME=03:30

# ESI diagnostics (Admin -> ESI Diagnostics). Off unless enabled.
ESI_DIAGNOSTICS_ENABLED=false

# Web push (notifications). Empty = push stays off.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Uploaded sponsor banners.
SPONSOR_DIR=storage/sponsors

# `task start` lanes: api | worker | worker-market | worker-updates | worker-all
APP_ROLE=worker-all
# `task start` web UI (Vite dev server proxying /api to the Go api).
UI_PORT=5173
LARAVEL_URL=http://localhost:8080
